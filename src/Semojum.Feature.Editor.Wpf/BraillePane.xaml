<UserControl x:Class="Semojum.Desktop.Controls.BraillePane" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:svg="http://sharpvectors.codeplex.com/svgc/" xmlns:editorFeature="clr-namespace:Semojum.Feature.Editor.Wpf" xmlns:local="clr-namespace:Semojum.Desktop.Controls">
  <DockPanel Background="White">
    <Border x:Name="Header" DockPanel.Dock="Top" Background="#F9F9F9" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1" Padding="12,0,4,0" Height="36">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" ClipToBounds="True">
              <Border x:Name="NumberBadge" Width="18" Height="18" CornerRadius="9" Background="#F0F0F0"><TextBlock x:Name="PanelNumber" Text="3" FontFamily="{StaticResource InterfaceFont}" Foreground="#5F5F5F" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock x:Name="PanelTitle" Text="점자" Margin="8,0,0,0" FontSize="14" Foreground="#5F5F5F" VerticalAlignment="Center"/>
            </StackPanel>
            <editorFeature:PanelPageBar x:Name="FacePageBar" Grid.Column="1" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="DetachButton" Click="Detach_Click" Style="{StaticResource IconButton}" Width="24" Height="24" MinWidth="0" MinHeight="0" Margin="0" Padding="0" ToolTip="점자 창 분리 / 합치기" AutomationProperties.Name="점자 창 분리 또는 합치기"><Border Width="12" Height="12" BorderThickness="1.3" BorderBrush="#5F5F5F" CornerRadius="1"/></Button>
              <Button Click="Hide_Click" Style="{StaticResource IconButton}" Width="24" Height="24" MinWidth="0" MinHeight="0" Margin="0" Padding="0" ToolTip="점자 패널 숨기기" AutomationProperties.Name="점자 패널 숨기기"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Feature.Editor.Wpf;component/Assets/Figma/panel-braille-close.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
            </StackPanel>
          </Grid>
        </Border>
    <local:LineTranslation x:Name="PreviewStrip" DockPanel.Dock="Bottom" Visibility="Collapsed"/>

    <TextBlock x:Name="StateLabel" Visibility="Collapsed"/>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="0"/><RowDefinition x:Name="GridHeight" Height="*"/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
      <DockPanel Margin="8,4" Visibility="Collapsed"><CheckBox x:Name="GridToggle" Content="모눈 보기" IsChecked="True" Click="GridToggle_Click"/>
        <TextBlock Text="  드래그·Shift 선택 · 6점 입력 · Ctrl+Z" FontSize="11" Foreground="Gray" ToolTip="BRF와 동일한 판면입니다. 본문을 직접 편집합니다. 회색 조판 영역은 자동 생성됩니다."/></DockPanel>
      <local:BrailleGridView x:Name="GridView" Grid.Row="1"/>
      <Border Grid.Row="1" Height="24" Padding="12,0" Margin="0,0,24,12" Background="#FBFBFB" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="12" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=LayoutLabel}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <TextBlock x:Name="LayoutLabel" FontSize="12" Foreground="#5F5F5F" VerticalAlignment="Center"/>
          </Border>
      <ae:TextEditor x:Name="Editor" Grid.Row="3" Visibility="Collapsed" FontFamily="{StaticResource BrailleFont}" FontSize="22" Padding="8,4" ShowLineNumbers="True" WordWrap="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="점자 편집 모델"/>
    </Grid>
  </DockPanel>
</UserControl>
