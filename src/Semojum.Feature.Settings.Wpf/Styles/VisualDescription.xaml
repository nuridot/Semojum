<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:svg="http://sharpvectors.codeplex.com/svgc/">
    <ControlTemplate x:Key="DraftCategory" TargetType="ListBoxItem">
        <Border x:Name="Frame" Background="Transparent" CornerRadius="4" Padding="12,0">
            <ContentPresenter VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#005FB8"/><Setter TargetName="Frame" Property="BorderThickness" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="DraftChoice" TargetType="CheckBox">
        <Border x:Name="Row" Background="White" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="4" Padding="12,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="Square" Width="16" Height="16" BorderBrush="#5F5F5F" Background="White" BorderThickness="1" CornerRadius="4">
                    <svg:SvgViewbox x:Name="Tick" Width="12" Height="12" Stretch="None" Visibility="Collapsed"
                            Source="pack://application:,,,/Semojum.Feature.Settings.Wpf;component/Assets/Figma/draft-types-check.svg"/>
                </Border>
                <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Square" Property="Background" Value="#005FB8"/><Setter TargetName="Square" Property="BorderBrush" Value="#005FB8"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#005FB8"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
