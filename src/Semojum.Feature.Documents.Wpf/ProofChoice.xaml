<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ProofChoice" TargetType="RadioButton">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#1A1A1A"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Card" CornerRadius="4" Background="White" BorderBrush="#EAEAEA" BorderThickness="1" Padding="12,0">
                        <DockPanel>
                            <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse x:Name="Ring" Fill="White" Stroke="#5F5F5F"/>
                                <Ellipse x:Name="Dot" Fill="White" Width="6" Height="6" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="#EFF6FC"/>
                            <Setter TargetName="Card" Property="BorderBrush" Value="#005FB8"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="#005FB8"/>
                            <Setter TargetName="Ring" Property="Fill" Value="#005FB8"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
