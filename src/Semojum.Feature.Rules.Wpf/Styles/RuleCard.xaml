<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svg="http://sharpvectors.codeplex.com/svgc/">
  <Style x:Key="RuleCard" TargetType="Expander">
    <Setter Property="Background" Value="White"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1" Padding="16,12">
        <StackPanel>
          <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Padding="0">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><ContentPresenter/></Border></ControlTemplate></ToggleButton.Template>
            <DockPanel>
              <svg:SvgViewbox x:Name="Arrow" Source="pack://application:,,,/Semojum.Feature.Rules.Wpf;component/Assets/Figma/catalog-right.svg" Width="16" Height="16" Stretch="None" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0"/>
              <ContentPresenter ContentSource="Header"/>
            </DockPanel>
          </ToggleButton>
          <ContentPresenter x:Name="Details" ContentSource="Content" Margin="0,4,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsExpanded" Value="True">
          <Setter TargetName="Surface" Property="BorderThickness" Value="1"/>
          <Setter TargetName="Surface" Property="CornerRadius" Value="8"/>
          <Setter TargetName="Details" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Arrow" Property="Source" Value="pack://application:,,,/Semojum.Feature.Rules.Wpf;component/Assets/Figma/catalog-down.svg"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
