<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svg="http://sharpvectors.codeplex.com/svgc/">
    <ControlTemplate x:Key="RuleScroll" TargetType="ScrollViewer">
        <Grid>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}"/>
            <ScrollBar x:Name="PART_VerticalScrollBar" AutomationProperties.Name="세로 스크롤" HorizontalAlignment="Right" Width="8" Opacity="0" Focusable="False"
                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                <ScrollBar.Template><ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Focusable="False">
                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb MinHeight="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" CornerRadius="2" Margin="2,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate></ScrollBar.Template>
            </ScrollBar>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="RuleTree" TargetType="TreeView">
        <ScrollViewer x:Name="TreeScroll" Template="{StaticResource RuleScroll}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{TemplateBinding Padding}" Focusable="False">
            <ItemsPresenter/>
        </ScrollViewer>
    </ControlTemplate>
    <Style TargetType="TreeViewItem" x:Key="RuleBranch">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="#5F5F5F"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="TreeViewItem">
                <StackPanel>
                    <Border x:Name="Row" Height="32" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <ToggleButton x:Name="Expand" Focusable="False" Width="16" Height="24" Margin="0,0,4,0" Padding="0"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template>
                                <svg:SvgViewbox x:Name="Chevron" Source="pack://application:,,,/Semojum.Feature.Rules.Wpf;component/Assets/Figma/catalog-right.svg" Width="16" Height="16" Stretch="None"/>
                            </ToggleButton>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ItemsPresenter x:Name="Children" Visibility="Collapsed"/>
                </StackPanel>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding Tag.RuleId, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}"><Setter Property="Foreground" Value="#1A1A1A"/></DataTrigger>
                    <Trigger Property="HasItems" Value="False"><Setter TargetName="Expand" Property="Visibility" Value="Hidden"/></Trigger>
                    <Trigger Property="IsExpanded" Value="True">
                        <Setter TargetName="Children" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="Chevron" Property="Source" Value="pack://application:,,,/Semojum.Feature.Rules.Wpf;component/Assets/Figma/catalog-down.svg"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EFF6FC"/><Setter Property="Foreground" Value="#003E92"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
</ResourceDictionary>
