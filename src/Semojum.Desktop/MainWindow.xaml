        </Border>
          <editorControls:ContinuousSourceEditor Grid.Row="1" x:Name="PageEditor" Visibility="Collapsed"/>
          <ae:TextEditor Grid.Row="1" x:Name="SourceEditor" FontFamily="{StaticResource InterfaceFont}" FontSize="14" ShowLineNumbers="True" WordWrap="True" Padding="8,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="원문 텍스트 편집기"/>
          <editorControls:MathPreviewDock Grid.Row="2" x:Name="MathDock" Visibility="Collapsed"/>
          <Border Grid.Row="1" Height="24" Padding="12,0" Margin="0,0,24,12" Background="#FBFBFB" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="12" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SourcePosition}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <TextBlock x:Name="SourcePosition" FontSize="12" Foreground="#5F5F5F" VerticalAlignment="Center"/>
          </Border>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="3" ResizeBehavior="PreviousAndNext"/>
      <Border x:Name="BrailleContainer" Grid.Column="4" BorderBrush="{StaticResource Line}" BorderThickness="0"><Grid>
        <editorControls:BraillePane x:Name="Braille"/>
        <Border x:Name="DetachedPlaceholder" Visibility="Collapsed" Background="#F4F6F8"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="점자 창이 분리되어 있습니다" FontSize="17"/><TextBlock Text="독립 창에서도 같은 블록을 편집합니다." Foreground="{StaticResource Muted}" Margin="0,12,0,20"/><Button Content="이 창으로 합치기" Tag="detach" Click="Action_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></Border>
      </Grid></Border>
      <Border x:Name="DraftDock" Grid.Column="2" Grid.ColumnSpan="3" Panel.ZIndex="10" VerticalAlignment="Bottom"
              Height="219" MaxHeight="{Binding ActualHeight, ElementName=PanelGrid}" Visibility="Collapsed"
              Background="White" BorderBrush="#D1D1D1" BorderThickness="1" CornerRadius="8">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="8" Opacity=".18"/></Border.Effect>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="8"/><RowDefinition Height="37"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.RowSpan="2" Background="#F9F9F9" CornerRadius="7,7,0,0" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1"/>
          <Thumb x:Name="DraftDockResize" Cursor="SizeNS" Focusable="True" DragDelta="DraftDockResize_DragDelta"
                 PreviewKeyDown="DraftDockResize_KeyDown" AutomationProperties.Name="대체 초안 높이 조절">
            <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent">
              <Border x:Name="Grip" Width="32" Height="4" VerticalAlignment="Bottom" CornerRadius="2" Background="#D1D1D1"/>
            </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Grip" Property="Background" Value="#005FB8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template>
          </Thumb>
          <DockPanel Grid.Row="1" Margin="16,0,4,1">
            <Button x:Name="DraftDockClose" DockPanel.Dock="Right" Click="DraftDockClose_Click" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                    Style="{StaticResource PanelButton}" Background="Transparent" BorderBrush="Transparent" ToolTip="선택한 초안 적용하고 닫기" AutomationProperties.Name="선택한 초안 적용하고 닫기">
              <svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/draft-dock-close.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/>
            </Button>
            <TextBlock x:Name="DraftDockTitle" FontFamily="{StaticResource InterfaceFont}" FontSize="14" Foreground="#1A1A1A" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
          <Border Grid.Row="2" MinHeight="48" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1">
            <ScrollViewer x:Name="DraftChoiceScroll" Margin="16,0" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Center">
              <StackPanel x:Name="DraftChoiceGrid" Orientation="Horizontal" VerticalAlignment="Center"/>
            </ScrollViewer>
          </Border>
          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="DraftTextColumn"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border BorderBrush="#EAEAEA" BorderThickness="0,0,1,0" Padding="16,12">
              <DockPanel><TextBlock DockPanel.Dock="Top" Text="묵자" FontSize="12" Foreground="#5F5F5F" Margin="0,0,0,4"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <TextBlock x:Name="DraftTextPreview" FontFamily="{Binding FontFamily, ElementName=SourceEditor}" FontSize="{Binding FontSize, ElementName=SourceEditor}"
                             Foreground="#1A1A1A" TextWrapping="Wrap" AutomationProperties.Name="선택한 초안 묵자 미리보기"/>
                </ScrollViewer>
              </DockPanel>
            </Border>
            <Border Grid.Column="1" Padding="16,12">
              <DockPanel><TextBlock DockPanel.Dock="Top" Text="점자" Height="16" FontSize="12" Foreground="#5F5F5F"/>
                <ScrollViewer x:Name="DraftBrailleScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <TextBlock x:Name="DraftBraillePreview" FontFamily="{StaticResource BraillePlainFont}"
                             Foreground="#1A1A1A" TextWrapping="Wrap" AutomationProperties.Name="선택한 초안 점자 미리보기"/>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    </ScrollViewer>
    <Grid x:Name="EmptyPanelActions" Visibility="Collapsed" Background="#F3F3F3">
      <Grid.Resources>
        <Style x:Key="RestoreTile" TargetType="Button">
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Grid>
              <Border Background="White" CornerRadius="8" IsHitTestVisible="False">
                <Border.Effect><DropShadowEffect BlurRadius="2" ShadowDepth="0" Opacity=".06"/></Border.Effect>
              </Border>
              <Border x:Name="Tile" Background="White" BorderBrush="#D1D1D1" BorderThickness="1" CornerRadius="8">
              <Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Opacity=".10"/></Border.Effect>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                <Border Width="48" Height="48" CornerRadius="24" Background="#EFF6FC">
                  <Grid Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <TextBlock Margin="0,8,0,0" Text="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}" FontSize="14" FontWeight="SemiBold" Foreground="#1A1A1A" HorizontalAlignment="Center"/>
              </StackPanel>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#005FB8"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#005FB8"/><Setter TargetName="Tile" Property="BorderThickness" Value="2"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
        </Style>
      </Grid.Resources>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center" Focusable="False">
        <StackPanel MaxWidth="512" Margin="8,4">
          <Grid Height="128">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Tag="original" AutomationProperties.Name="원본 패널" ToolTip="원본 패널 켜기" Style="{StaticResource RestoreTile}" Click="RestorePanel_Click">
              <svg:SvgViewbox Width="24" Height="24" Stretch="None" IsHitTestVisible="False" Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/restore-original.svg"/>
            </Button>
            <Button Grid.Column="2" Tag="source" AutomationProperties.Name="묵자 패널" ToolTip="묵자 패널 켜기" Style="{StaticResource RestoreTile}" Click="RestorePanel_Click">
              <svg:SvgViewbox Width="24" Height="24" Stretch="None" IsHitTestVisible="False" Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/restore-source.svg"/>
            </Button>
            <Button Grid.Column="4" Tag="braille" AutomationProperties.Name="점자 패널" ToolTip="점자 패널 켜기" Style="{StaticResource RestoreTile}" Click="RestorePanel_Click">
              <svg:SvgViewbox Width="24" Height="24" Stretch="None" IsHitTestVisible="False" Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/restore-braille.svg"/>
            </Button>
          </Grid>
          <Button Tag="all" Content="모두 켜기" HorizontalAlignment="Center" Width="88" Height="32" Margin="0,20,0,0" Click="RestorePanel_Click" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    </Grid>
  </DockPanel>
</Window>
