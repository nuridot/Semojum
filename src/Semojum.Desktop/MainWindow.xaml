<Window x:Class="Semojum.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:svg="http://sharpvectors.codeplex.com/svgc/" xmlns:editorFeature="clr-namespace:Semojum.Feature.Editor.Wpf;assembly=Semojum.Feature.Editor.Wpf" xmlns:editorControls="clr-namespace:Semojum.Desktop.Controls;assembly=Semojum.Feature.Editor.Wpf" xmlns:local="clr-namespace:Semojum.Desktop.Controls"
        Style="{StaticResource {x:Type Window}}" ShowInTaskbar="True" Title="{Binding WindowTitle}" Width="1440" Height="1000" MinWidth="1280" MinHeight="800" WindowStartupLocation="CenterScreen" Closing="Window_Closing" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Controls/FinalMenuStyles.xaml"/></ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="RibbonCaptionInk" Color="#8A8A8A"/>
      <Style x:Key="StatusBusyIcon" TargetType="Border">
        <Setter Property="Width" Value="12"/><Setter Property="Height" Value="12"/>
        <Setter Property="Margin" Value="2,0,6,0"/><Setter Property="CornerRadius" Value="1"/>
        <Setter Property="BorderThickness" Value="1.3"/><Setter Property="BorderBrush" Value="#5F5F5F"/>
      </Style>
      <Style x:Key="DraftChoice" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/><Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#1A1A1A"/><Setter Property="Background" Value="#FBFBFB"/>
        <Setter Property="BorderBrush" Value="#EAEAEA"/><Setter Property="Padding" Value="16,0"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
          <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#005FB8"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#005FB8"/><Setter TargetName="Face" Property="BorderThickness" Value="2"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="#EFF6FC"/><Setter Property="BorderBrush" Value="#005FB8"/><Setter Property="Foreground" Value="#003E92"/>
          <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/>
        </Trigger></Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel LastChildFill="True">
    <Grid DockPanel.Dock="Top" Background="#F3F3F3">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TabControl Grid.Row="1" x:Name="EditorRibbon" Tag="{Binding IsChecked, ElementName=ToolbarToggle}" Background="#F3F3F3" Padding="0" BorderThickness="0" AutomationProperties.Name="편집 리본">
        <TabControl.ItemContainerStyle><Style TargetType="TabItem">
          <Setter Property="Foreground" Value="#5F5F5F"/><Setter Property="FontSize" Value="14"/><Setter Property="Height" Value="32"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
            <Border x:Name="Face" CornerRadius="4" Background="Transparent" Padding="12,4,12,0"><Grid>
              <ContentPresenter ContentSource="Header" Height="20" VerticalAlignment="Top" HorizontalAlignment="Center" RecognizesAccessKey="True"/>
              <Border x:Name="Indicator" Background="#005FB8" Height="3" Width="16" CornerRadius="1.5" Margin="0,0,0,1" VerticalAlignment="Bottom" Visibility="Collapsed"/>
            </Grid></Border><ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#F0F0F0"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Face" Property="MinWidth" Value="40"/><Setter TargetName="Face" Property="Background" Value="White"/><Setter Property="Foreground" Value="#003E92"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="Indicator" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#005FB8"/><Setter TargetName="Face" Property="BorderThickness" Value="1"/></Trigger>
            </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style></TabControl.ItemContainerStyle>
        <TabControl.Template><ControlTemplate TargetType="TabControl">
          <DockPanel><TabPanel IsItemsHost="True" DockPanel.Dock="Top" Height="32" Margin="8,0,0,0" KeyboardNavigation.TabIndex="0"/>
            <Border x:Name="RibbonBody" Height="88" Padding="4,0,0,0" BorderBrush="#D1D1D1" BorderThickness="0,0,0,1" Background="White">
              <ContentPresenter ContentSource="SelectedContent" />
            </Border>
          </DockPanel>
          <ControlTemplate.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="False"><Setter TargetName="RibbonBody" Property="Visibility" Value="Collapsed"/></DataTrigger></ControlTemplate.Triggers>
        </ControlTemplate></TabControl.Template>
      </TabControl>
      <StackPanel x:Name="RibbonHeaderActions" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Height="32" Margin="0,0,8,0">
        <Button x:Name="RuleSearch" Width="200" Height="24" Margin="0" Padding="8,0" MinHeight="0" HorizontalContentAlignment="Stretch"
                  Background="White" BorderBrush="#D1D1D1" BorderThickness="1" Click="RuleSearch_Click" AutomationProperties.Name="점역 규정 검색">
            <Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
            <DockPanel><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/ribbon-find.svg" Width="16" Height="16" Stretch="None" Margin="0,0,8,0"/>
              <TextBlock Text="점역 규정 검색..." FontSize="12" Foreground="#8A8A8A" IsHitTestVisible="False"/></DockPanel>
          </Button>
        <Border x:Name="ToolbarAccount" MaxWidth="152" Height="24" Margin="8,0,8,0" VerticalAlignment="Center" Background="#F0F0F0" CornerRadius="4">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
            <Button x:Name="AccountOpen" Style="{StaticResource ToolButton}" MinWidth="0" MinHeight="0" Height="24" Padding="8,0,0,0" Margin="0" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Click="AccountOpen_Click" ToolTip="마이페이지" AutomationProperties.Name="마이페이지">
              <DockPanel><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/editor-account-user.svg" Width="16" Height="16" Stretch="None" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding Text, ElementName=AccountLabel}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
            </Button>
            <Button x:Name="AccountMenuButton" Grid.Column="1" Style="{StaticResource ToolButton}" MinHeight="0" MinWidth="0" Height="24" Width="24" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" Click="RibbonAccount_Click" ToolTip="계정 메뉴" AutomationProperties.Name="계정 메뉴">
              <svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/ribbon-chevd.svg" Width="12" Height="12" Margin="0,0,4,0" Stretch="None"/>
            </Button>
          </Grid>
        </Border>
        <Button x:Name="RibbonNotifications" Click="RibbonNotifications_Click" Style="{StaticResource ToolButton}" Width="32" Height="24" Padding="0" Margin="0" MinWidth="0" MinHeight="0" Background="Transparent" AutomationProperties.Name="알림">
          <Grid Width="32" Height="24"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/ribbon-bell.svg" Width="16" Height="16" Stretch="None"/>
            <Border x:Name="RibbonBadge" CornerRadius="7" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#C42B1C" Padding="4,0" Visibility="{Binding Visibility, ElementName=RibbonUnread}">
              <TextBlock x:Name="RibbonUnread" Visibility="Collapsed" Foreground="White" FontSize="10" VerticalAlignment="Center"/>
            </Border>
          </Grid>
        </Button>
        <ToggleButton x:Name="AdditionalCommands" FontSize="12" MinHeight="0" Height="16" Foreground="{StaticResource RibbonCaptionInk}"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" ToolTip="전체 명령과 도구 모음 열기 또는 닫기" AutomationProperties.Name="편집창 전체 명령">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Face" Background="Transparent" CornerRadius="4">
              <TextBlock Text="편집창" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#F0F0F0"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Face" Property="Background" Value="#E5F1FB"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="Background" Value="#E5F1FB"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></ToggleButton.Template>
        </ToggleButton>
      </StackPanel>
    </Grid>
    <StackPanel DockPanel.Dock="Top">
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=AdditionalCommands}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <Border DockPanel.Dock="Top" Height="32" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel>

        <Menu x:Name="ApplicationMenu" Height="32" FontSize="12" Padding="0" Margin="4,0,0,0">
          <Menu.Resources><Style TargetType="MenuItem" BasedOn="{StaticResource FinalDesktopMenuItem}"/></Menu.Resources>
          <MenuItem Header="파일(_F)" Width="64">
            <MenuItem Header="새 문서" InputGestureText="Ctrl+N" Tag="new" Click="Action_Click"/>
            <MenuItem Header="열기" InputGestureText="Ctrl+O" Tag="open" Click="Action_Click"/>
            <Separator/>
            <MenuItem Header="저장" InputGestureText="Ctrl+S" Tag="save" Click="Action_Click"/>
            <MenuItem Header="작업 완료" Tag="completeWork" Click="Action_Click" AutomationProperties.Name="저장하고 작업 완료"/>
            <MenuItem Header="다른 이름으로 저장" Tag="saveAs" Click="Action_Click"/>
            <MenuItem Header="범위 지정 저장" Tag="export" Click="Action_Click"/>
            <MenuItem x:Name="RecentFilesMenu" Visibility="Collapsed" Header="최근 문서" SubmenuOpened="RecentFiles_Opened"/>
          </MenuItem>
          <MenuItem Header="편집(_E)" Width="64">
            <MenuItem Header="되돌리기" InputGestureText="Ctrl+Z" Tag="undo" Click="Action_Click"/>
            <MenuItem Header="다시 실행" InputGestureText="Ctrl+Y" Tag="redo" Click="Action_Click"/>
            <Separator/>
            <MenuItem Header="잘라내기" InputGestureText="Ctrl+X" Tag="cut" Click="Action_Click"/>
            <MenuItem Header="복사" InputGestureText="Ctrl+C" Tag="copy" Click="Action_Click"/>
            <MenuItem Header="붙여넣기" InputGestureText="Ctrl+V" Tag="paste" Click="Action_Click"/>
            <MenuItem Header="전체 선택" InputGestureText="Ctrl+A" Tag="selectAll" Click="Action_Click"/>
            <Separator/>
            <MenuItem Header="찾기 · 바꾸기" InputGestureText="Ctrl+F" Tag="find" Click="Action_Click"/>
            <MenuItem Header="이동" InputGestureText="Ctrl+G" Tag="goto" Click="Action_Click"/>
          </MenuItem>
          <MenuItem Header="보기(_V)" Width="64">
            <MenuItem Header="글자 크기">
              <MenuItem Header="작게" Tag="zoomOut" Click="Action_Click" Style="{StaticResource FinalDesktopNestedItem}"/>
              <MenuItem Header="보통" Tag="zoomReset" Click="Action_Click" Style="{StaticResource FinalDesktopNestedItem}"/>
              <MenuItem Header="크게" Tag="zoomIn" Click="Action_Click" Style="{StaticResource FinalDesktopNestedItem}"/>
            </MenuItem>
            <Separator/>
            <MenuItem x:Name="FormattingToggle" Header="조판부호" IsCheckable="True" Tag="formatMarks" Click="Action_Click"/>
            <MenuItem x:Name="OutlineToggle" Header="쪽 분리 윤곽선" IsCheckable="True" IsChecked="True" Tag="showOutlines" Click="Action_Click"/>
            <MenuItem x:Name="LineNumbersToggle" Header="줄 번호" IsCheckable="True" IsChecked="True" Click="LineNumbersToggle_Click"/>
            <Separator/>
            <MenuItem x:Name="ToolbarToggle" Header="도구 모음" IsCheckable="True" IsChecked="True" Tag="showToolbar" Click="Action_Click"/>
            <MenuItem x:Name="StatusToggle" Header="상태 표시줄" IsCheckable="True" IsChecked="True" Tag="showStatus" Click="Action_Click"/>
            <MenuItem x:Name="LinePreviewToggle" Header="줄번역" IsCheckable="True" IsChecked="True" Click="LinePreviewToggle_Click"/>
            <MenuItem x:Name="MemoToggle" Header="메모 표시" IsCheckable="True" IsChecked="True" Tag="showMemos" Click="Action_Click"/>
            <MenuItem x:Name="ReviewToggle" Header="검토 표시" IsCheckable="True" IsChecked="True" Tag="showReviews" Click="Action_Click"/>
            <Separator/>
            <MenuItem x:Name="OriginalToggle" Header="원본 패널" IsCheckable="True" IsChecked="True" Click="OriginalToggle_Click"/>
            <MenuItem x:Name="SourceToggle" Header="묵자 패널" IsCheckable="True" IsChecked="True" Click="PanelToggle_Click"/>
            <MenuItem x:Name="BrailleToggle" Header="점자 패널" IsCheckable="True" IsChecked="True" Click="PanelToggle_Click"/>
            <MenuItem Header="패널 모두 제자리로" Tag="restorePanels" Click="Action_Click"/>
          </MenuItem>
          <MenuItem x:Name="AllTagsMenu" Header="삽입(_I)" Width="64">
            <MenuItem Header="꼬리말..." Tag="footerInsert" Click="Action_Click"/>
            <MenuItem Header="꼬리말 관리..." Tag="footer" Click="Action_Click"/>
            <MenuItem Header="수식 입력창" Tag="math" Click="Action_Click"/>
          </MenuItem>
          <MenuItem Header="설정(_M)" Width="64">
            <MenuItem Header="편집용 점자문서 페이지설정" InputGestureText="Alt+Y" Tag="layout" Click="Action_Click"/>
            <MenuItem x:Name="AccountOutputDefaults" Header="계정 출력 기본값" Visibility="Collapsed" Tag="outputdefaults" Click="Action_Click"/>
            <MenuItem Header="기본 점역 옵션 설정" InputGestureText="Alt+G" Tag="defaults" Click="Action_Click"/>
            <MenuItem Header="점역 양식" Tag="forms" Click="Action_Click"/>
            <MenuItem Header="6점키 설정" InputGestureText="Alt+K" Tag="sixdot" Click="Action_Click"/>
            <MenuItem Header="시각 자료 설명 유형" Tag="visualDescriptions" Click="Action_Click"/>
            <MenuItem Header="점형 읽기 및 도구 모음" Tag="readingOptions" Click="Action_Click"/>
            <Separator/>
            <MenuItem x:Name="AutoUpdateToggle" Header="업데이트 자동 확인" IsCheckable="True" IsChecked="True" Tag="autoUpdate" Click="Action_Click"/>
            <MenuItem x:Name="SixDotToggle" Visibility="Collapsed" Header="6점 입력" IsCheckable="True" Checked="SixDotToggle_Changed" Unchecked="SixDotToggle_Changed"/>
          </MenuItem>
          <MenuItem Header="정보(_A)" Width="64">
            <MenuItem Header="도움말" InputGestureText="F1" Tag="help" Click="Action_Click"/>
            <Separator/>
            <MenuItem Header="마이페이지 · 사용량" Tag="usage" Click="Action_Click"/>
            <Separator/>
            <MenuItem Header="게시판" Tag="board" Click="Action_Click"/>
            <MenuItem Header="문의하기" Tag="inquiry" Click="Action_Click"/>
            <MenuItem Header="누리닷 정보" Tag="about" Click="Action_Click"/>
            <MenuItem x:Name="TimeoutToggle" Visibility="Collapsed" Header="점역 응답 지연 체험" IsCheckable="True" Click="TimeoutToggle_Click"/>
          </MenuItem>
        </Menu>
      </DockPanel>
    </Border>
    <!-- Toolbars size to their content: the ScrollViewer adds its scrollbar row in the same measure pass, so a width-only resize never leaves a stale 40px height. -->
    <Border x:Name="EditorToolbar" DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1" Padding="8,0">
      <ScrollViewer x:Name="EditorToolbarScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="기본 도구 모음 가로 스크롤">
      <DockPanel Height="39">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
          <Button Content="‹" Tag="previous" Click="Action_Click" Style="{StaticResource FormatButton}" ToolTip="이전 블록"/>
          <ComboBox x:Name="BlockPicker" Width="150" Height="26" MinHeight="26" FontSize="12" Padding="4,0" ItemsSource="{Binding Blocks}" DisplayMemberPath="Label" SelectedItem="{Binding ActiveBlock, Mode=OneWay}" SelectionChanged="BlockPicker_SelectionChanged" AutomationProperties.Name="작업 블록 선택"/>
          <Button Content="›" Tag="next" Click="Action_Click" Style="{StaticResource FormatButton}" ToolTip="다음 블록"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Tag="new" ToolTip="새 문서 (Ctrl+N)" AutomationProperties.Name="새 문서 (Ctrl+N)" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-new.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Button Tag="open" ToolTip="열기 (Ctrl+O)" AutomationProperties.Name="열기 (Ctrl+O)" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-open.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Button Tag="save" ToolTip="저장 (Ctrl+S)" AutomationProperties.Name="저장 (Ctrl+S)" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-save.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Border Width="1" Height="18" Background="#EAEAEA" Margin="8,0"/>
          <Button Tag="cut" ToolTip="잘라내기 (Ctrl+X)" AutomationProperties.Name="잘라내기 (Ctrl+X)" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox x:Name="CutIcon" Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-cut.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Button Tag="copy" ToolTip="복사 (Ctrl+C)" AutomationProperties.Name="복사 (Ctrl+C)" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-copy.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Button Tag="paste" ToolTip="붙여넣기 (Ctrl+V)" AutomationProperties.Name="붙여넣기 (Ctrl+V)" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-paste.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Border Width="1" Height="18" Background="#EAEAEA" Margin="8,0"/>
          <Button Tag="undo" ToolTip="되돌리기 (Ctrl+Z)" AutomationProperties.Name="되돌리기 (Ctrl+Z)" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-undo.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Button Tag="redo" ToolTip="다시 실행 (Ctrl+Y)" AutomationProperties.Name="다시 실행 (Ctrl+Y)" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-redo.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Border Width="1" Height="18" Background="#EAEAEA" Margin="8,0"/>
          <Button Tag="find" ToolTip="찾기 (Ctrl+F)" AutomationProperties.Name="찾기 (Ctrl+F)" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-find.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Button Tag="goto" ToolTip="이동 (Ctrl+G)" AutomationProperties.Name="이동 (Ctrl+G)" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-goto.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Border Width="1" Height="18" Background="#EAEAEA" Margin="8,0"/>
          <Button Tag="translate" ToolTip="현재 블록 다시 점역" AutomationProperties.Name="현재 블록 다시 점역" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-recon.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Button Tag="export" ToolTip="문서 내보내기" AutomationProperties.Name="문서 내보내기" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-export.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <ComboBox x:Name="ZoomPicker" Visibility="Collapsed" Width="92" Height="32" FontSize="12" SelectionChanged="ZoomPicker_SelectionChanged" AutomationProperties.Name="편집기 확대 비율"/>
        </StackPanel>
      </DockPanel>
      </ScrollViewer>
    </Border>
    <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1" Padding="8,0">
      <DockPanel>

      <ScrollViewer x:Name="FormatToolbarScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="서식 도구 모음 가로 스크롤">
      <StackPanel Orientation="Horizontal" Height="31">
        <ComboBox x:Name="TextStylePicker" Width="104" Height="24" MinHeight="24" FontSize="12" SelectedIndex="0" SelectionChanged="TextStylePicker_SelectionChanged" AutomationProperties.Name="텍스트 서식"><ComboBoxItem Content="본문"/><ComboBoxItem Content="강조"/><ComboBoxItem Content="굵은"/><ComboBoxItem Content="색강조"/><ComboBoxItem Content="취소선"/></ComboBox>
        <ComboBox x:Name="FontSizeLabel" Width="72" Height="24" MinHeight="24" Margin="4,0" FontSize="12" SelectionChanged="FontSizePicker_SelectionChanged" AutomationProperties.Name="활성 패널 표시 크기"/>
        <Border Background="#F0F0F0" CornerRadius="12" Padding="12,0" Height="24" MinWidth="173"><TextBlock x:Name="OptionsLabel" FontSize="12" Foreground="#8A8A8A"/></Border>
<Border Width="1" Height="16" Background="#EAEAEA" Margin="8,0"/>
        <Button Tag="tag:쪽바꿈" ToolTip="쪽바꿈" AutomationProperties.Name="쪽바꿈" Click="Action_Click" Style="{StaticResource FormatButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-pagebreak.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
