<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svg="http://sharpvectors.codeplex.com/svgc/" xmlns:local="clr-namespace:Semojum.Desktop.Controls">
  <ControlTemplate x:Key="RibbonToggleTemplate" TargetType="CheckBox">
    <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="4,0,8,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="Box" Width="16" Height="16" BorderBrush="#5F5F5F" BorderThickness="1" Background="White" CornerRadius="4" Margin="0,0,4,0">
          <svg:SvgViewbox x:Name="Check" Width="12" Height="12" Stretch="None" Visibility="Hidden" Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/ribbon-check.svg"/>
        </Border>
        <ContentPresenter VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#005FB8"/><Setter TargetName="Box" Property="BorderBrush" Value="#005FB8"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F0F0F0"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="Background" Value="#E5F1FB"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="RibbonChoiceButton" TargetType="Button">
    <StackPanel Orientation="Horizontal" Background="Transparent">
      <local:RibbonLabelBox Margin="0,0,8,0"><TextBlock Text="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" FontSize="12" Foreground="#5F5F5F"/></local:RibbonLabelBox>
      <Border x:Name="Field" Width="96" Height="20" CornerRadius="4" BorderBrush="#D1D1D1" BorderThickness="1" Background="White" Padding="8,0,4,0">
        <DockPanel><svg:SvgViewbox DockPanel.Dock="Right" Width="12" Height="12" Stretch="None" Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/ribbon-chevd.svg"/>
          <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" TextElement.Foreground="#1A1A1A"/>
        </DockPanel>
      </Border>
    </StackPanel>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="Background" Value="#FBFBFB"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#005FB8"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="RibbonChoiceMenu" TargetType="ContextMenu">
    <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="Width" Value="272"/><Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
      <Border x:Name="Card" Margin="16,8,16,24" CornerRadius="8" Background="#FBFBFB" BorderBrush="#EAEAEA" BorderThickness="1" Padding="0,4">
        <Border.Effect><DropShadowEffect Color="Black" ShadowDepth="8" Direction="270" BlurRadius="16" Opacity="0.14"/></Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RibbonChoiceItem" TargetType="MenuItem">
    <Setter Property="Height" Value="32"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#1A1A1A"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
      <Border x:Name="Row" CornerRadius="4" Background="Transparent" Padding="8,0,12,0">
        <DockPanel>
          <Border x:Name="Marker" DockPanel.Dock="Left" Width="3" Height="16" CornerRadius="1.5" Margin="0,0,8,0"/>
          <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontFamily="{StaticResource BraillePlainFont}" FontSize="22" Foreground="#5F5F5F" Text="{TemplateBinding Icon}"/>
          <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </DockPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Row" Property="Background" Value="#F0F0F0"/><Setter TargetName="Marker" Property="Background" Value="#005FB8"/></Trigger>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#F0F0F0"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#005FB8"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/><Setter TargetName="Row" Property="Padding" Value="7,0,11,0"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FinalContextSeparator" TargetType="Separator">
    <Setter Property="Height" Value="9"/><Setter Property="Margin" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Background="#EAEAEA" Height="1" Margin="8,0" VerticalAlignment="Center"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FinalContextItem" TargetType="MenuItem">
    <Setter Property="Padding" Value="8,0,12,0"/>
    <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/>
    <Setter Property="Height" Value="32"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#1A1A1A"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
      <Grid>
        <Border x:Name="Surface" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ContentPresenter ContentSource="Icon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" FontSize="12" Foreground="#8A8A8A" VerticalAlignment="Center"/>
            <svg:SvgViewbox x:Name="Arrow" Grid.Column="2" Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/text-context-chevron.svg" Width="16" Height="16" Stretch="None" Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
        </Border>
        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="1" VerticalOffset="-5" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False">
          <Border Width="200" Background="#FBFBFB" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="8" Padding="0,4"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer></Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F0F0F0"/></Trigger>
        <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F0F0F0"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FinalContextMenu" TargetType="ContextMenu">
    <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/>
    <Setter Property="Width" Value="248"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
      <Border Background="#FBFBFB" BorderBrush="#EAEAEA" BorderThickness="1" Padding="0,4" CornerRadius="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FinalDesktopMenuItem" TargetType="MenuItem">
    <Setter Property="Height" Value="24"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#1A1A1A"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
      <Grid>
        <Border x:Name="Surface" Background="Transparent" Padding="10,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Check" Text="✓" Visibility="Collapsed" Width="16" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/><TextBlock x:Name="Arrow" Text="▸" Visibility="Collapsed" Margin="2,0,0,0"/></StackPanel>
            <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="#5F5F5F" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </Grid>
        </Border>
        <Popup x:Name="PART_Popup" Placement="Custom" local:ShadowPopupPlacement.Enabled="True" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False">
          <Border x:Name="PopupSurface" Width="220" Margin="20" Background="#FBFBFB" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="6" Padding="3,7"><Border.Effect><DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="8" Direction="270" Opacity="0.14"/></Border.Effect><ScrollViewer MaxHeight="720" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer></Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F0F0F0"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
        <Trigger Property="Role" Value="TopLevelHeader"><Setter Property="Height" Value="32"/><Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/><Setter TargetName="PopupSurface" Property="Width" Value="222"/><Setter TargetName="PopupSurface" Property="Margin" Value="0"/><Setter TargetName="PopupSurface" Property="Effect" Value="{x:Null}"/><Setter TargetName="PopupSurface" Property="CornerRadius" Value="0"/><Setter TargetName="PopupSurface" Property="Padding" Value="0,5"/><Setter TargetName="PopupSurface" Property="Background" Value="White"/><Setter TargetName="PopupSurface" Property="BorderBrush" Value="#D1D1D1"/><Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/><Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FinalDesktopNestedItem" TargetType="MenuItem" BasedOn="{StaticResource FinalDesktopMenuItem}"><Setter Property="Height" Value="32"/></Style>
</ResourceDictionary>
