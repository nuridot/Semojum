<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Semojum.Desktop.Controls">
    <ControlTemplate x:Key="SwitchTemplate" TargetType="CheckBox">
        <StackPanel x:Name="Body" Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent"
                    controls:FigmaSystemContrast.IsHighContrast="{DynamicResource {x:Static SystemParameters.HighContrastKey}}">
            <Border x:Name="ToggleTrack" Width="40" Height="20" Background="White" BorderBrush="#5F5F5F" BorderThickness="1" CornerRadius="10" Padding="4,0">
                <Ellipse x:Name="Knob" Fill="#5F5F5F" Width="12" Height="12" HorizontalAlignment="Left"/>
            </Border>
            <TextBlock x:Name="ToggleLabel" Text="끔" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ToggleTrack" Property="Background" Value="#005FB8"/>
                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="#005FB8"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                <Setter TargetName="ToggleLabel" Property="Text" Value="켬"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="#1A1A1A"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.5"/></Trigger>
            <Trigger SourceName="Body" Property="controls:FigmaSystemContrast.IsHighContrast" Value="True">
                <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                <Setter TargetName="ToggleLabel" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition SourceName="Body" Property="controls:FigmaSystemContrast.IsHighContrast" Value="True"/>
                    <Condition Property="IsChecked" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition SourceName="Body" Property="controls:FigmaSystemContrast.IsHighContrast" Value="True"/>
                    <Condition Property="IsEnabled" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Body" Property="Opacity" Value="1"/>
                <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                <Setter TargetName="ToggleLabel" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
