<UserControl x:Class="Semojum.Desktop.Dialogs.BoardWriteForm" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontSize="14">
  <UserControl.Resources>
    <Style x:Key="LabelCell" TargetType="Border">
      <Setter Property="Width" Value="140"/><Setter Property="Background" Value="#F9F9F9"/>
      <Setter Property="Padding" Value="16,0"/><Setter Property="MinHeight" Value="44"/>
      <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Rule" TargetType="Border">
      <Setter Property="BorderBrush" Value="#EAEAEA"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style x:Key="Entry" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#1A1A1A"/>
      <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D1D1D1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderThickness="1"
                BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ScrollViewer x:Name="PART_ContentHost"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True">
          <Setter TargetName="Frame" Property="BorderBrush" Value="#005FB8"/>
        </Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="14"/><Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Foreground" Value="#8A8A8A"/>
      <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Height="28" Margin="0,0,0,16"/>
    <Border Background="#1A1A1A" Height="2"/>
    <Border Style="{StaticResource Rule}"><DockPanel>
      <Border Style="{StaticResource LabelCell}"><TextBlock Text="분류"/></Border>
      <WrapPanel x:Name="Categories" Margin="16,8" VerticalAlignment="Center" AutomationProperties.Name="게시글 분류">
        <WrapPanel.Resources><ResourceDictionary Source="/Semojum.UI.Common;component/Controls/CompactRadio.xaml"/></WrapPanel.Resources>
      </WrapPanel>
    </DockPanel></Border>
    <Border Style="{StaticResource Rule}"><DockPanel>
      <Border Style="{StaticResource LabelCell}"><TextBlock Text="제목"/></Border>
      <Grid Margin="16,8">
        <TextBox x:Name="TitleInput" Height="32" MaxLength="100" Style="{StaticResource Entry}" Padding="12,0" VerticalContentAlignment="Center" AutomationProperties.Name="게시글 제목"/>
        <TextBlock Text="제목 (100자)" Margin="13,0" AutomationProperties.AutomationId="BoardTitlePlaceholder">
          <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Hint}"><Style.Triggers>
            <DataTrigger Binding="{Binding Text, ElementName=TitleInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
          </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </Grid>
    </DockPanel></Border>
    <Border Style="{StaticResource Rule}"><DockPanel>
      <Border Style="{StaticResource LabelCell}"><TextBlock Text="내용"/></Border>
      <Grid Margin="16,8">
        <TextBox x:Name="ContentInput" Style="{StaticResource Entry}" Height="240" Padding="12,8" MaxLength="10000"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="게시글 본문"/>
        <TextBlock Text="내용 (10,000자)" VerticalAlignment="Top" Margin="13,9" AutomationProperties.AutomationId="BoardContentPlaceholder">
          <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Hint}"><Style.Triggers>
            <DataTrigger Binding="{Binding Text, ElementName=ContentInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
          </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </Grid>
    </DockPanel></Border>
    <Border Style="{StaticResource Rule}"><DockPanel>
      <Border Style="{StaticResource LabelCell}"><TextBlock Text="첨부"/></Border>
      <StackPanel Margin="16,8">
        <WrapPanel><Button x:Name="ChooseFile" Content="파일 추가" Width="88" Height="32" AutomationProperties.Name="파일 첨부"/>
          <TextBlock Text="최대 5개 · 10MB" Margin="12,0,0,0" FontSize="12" Foreground="#5F5F5F"/></WrapPanel>
        <ListBox x:Name="FileList" Margin="0,6,0,0" Visibility="Collapsed" AutomationProperties.Name="첨부한 파일"/>
      </StackPanel>
    </DockPanel></Border>
    <Border Style="{StaticResource Rule}"><DockPanel>
      <Border Style="{StaticResource LabelCell}"><TextBlock Text="설정"/></Border>
      <WrapPanel VerticalAlignment="Center" Margin="16,8">
        <CheckBox x:Name="Secret" Content="비밀글" Margin="0,0,12,0"/>
        <CheckBox x:Name="IncludeWork" Content="현재 작업 정보 첨부" Margin="0" ToolTip="원본·편집 내용은 포함되지 않습니다."/>
      </WrapPanel>
    </DockPanel></Border>
    <WrapPanel x:Name="Actions" HorizontalAlignment="Center" Margin="0,24,0,0"/>
  </StackPanel>
</UserControl>
