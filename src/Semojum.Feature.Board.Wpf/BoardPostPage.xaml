<UserControl x:Class="Semojum.Desktop.Dialogs.BoardPostPage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontSize="14">
  <UserControl.Resources>
    <ControlTemplate x:Key="RowAction" TargetType="Button">
      <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="4">
        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#EFF6FC"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#005FB8"/><Setter TargetName="Face" Property="BorderThickness" Value="1"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </UserControl.Resources>
  <StackPanel>
    <Border Padding="0,16" BorderThickness="0,2,0,1" BorderBrush="#1A1A1A">
      <StackPanel>
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="Metadata" FontSize="12" Foreground="#8A8A8A" Margin="0,8,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <TextBlock x:Name="Message" Margin="0,16,0,0" TextWrapping="Wrap"/>
    <StackPanel x:Name="Files"/>
    <StackPanel x:Name="Answers"/>
    <StackPanel x:Name="Neighbors"/>
    <DockPanel Margin="0,16,0,0" LastChildFill="False">
      <StackPanel x:Name="ReturnActions" Orientation="Horizontal"/>
      <StackPanel x:Name="AuthorActions" DockPanel.Dock="Right" Orientation="Horizontal"/>
    </DockPanel>
  </StackPanel>
</UserControl>
