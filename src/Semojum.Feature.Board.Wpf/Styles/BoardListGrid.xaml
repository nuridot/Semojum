<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Semojum.UI.Common;component/Styles/GridBehavior.xaml"/></ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="BoardNumber">
    <Border x:Name="Badge" HorizontalAlignment="Center" Background="#005FB8" Padding="8,0" CornerRadius="4">
      <TextBlock x:Name="Number" Text="{Binding Number}" FontSize="12" Foreground="White" VerticalAlignment="Center" MinHeight="20" TextAlignment="Center"/>
    </Border>
    <DataTemplate.Triggers><DataTrigger Binding="{Binding NoticeId}" Value="{x:Null}">
      <Setter TargetName="Badge" Property="Background" Value="Transparent"/><Setter TargetName="Badge" Property="Padding" Value="0"/>
      <Setter TargetName="Number" Property="Foreground" Value="#5F5F5F"/>
    </DataTrigger></DataTemplate.Triggers>
  </DataTemplate>
  <!-- This screen owns its header, cell, selection, and grid appearance. -->
  <Style x:Key="BoardListHeader" TargetType="DataGridColumnHeader">
    <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Background" Value="#F9F9F9"/><Setter Property="Foreground" Value="#5F5F5F"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12,0,0,0"/>
    <Setter Property="BorderBrush" Value="#EAEAEA"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style x:Key="BoardListCell" TargetType="DataGridCell" BasedOn="{StaticResource GridCellBehavior}">
    <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,0,0,0"/><Setter Property="Foreground" Value="#1A1A1A"/>
    <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EFF6FC"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="BoardListGrid" TargetType="DataGrid" BasedOn="{StaticResource GridBehavior}">
    <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="White"/><Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EAEAEA"/><Setter Property="ColumnHeaderHeight" Value="44"/>
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource BoardListHeader}"/><Setter Property="CellStyle" Value="{StaticResource BoardListCell}"/>
  </Style>
</ResourceDictionary>
