<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="IdentityMenu" TargetType="ContextMenu">
      <Setter Property="Width" Value="220"/><Setter Property="Height" Value="135"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
        <Border Background="#FBFBFB" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="8"><StackPanel Margin="0,4" IsItemsHost="True"/></Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="IdentityMenuHeader" TargetType="MenuItem">
      <Setter Property="Focusable" Value="False"/><Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Height" Value="53"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Border BorderBrush="#EAEAEA" BorderThickness="0,0,0,1" Padding="12,0"><ContentPresenter ContentSource="Header" VerticalAlignment="Center"/></Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="IdentityMenuAction" TargetType="MenuItem">
      <Setter Property="Height" Value="36"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#1A1A1A"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Grid>
          <Border x:Name="Surface" Padding="12,0" CornerRadius="4" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ContentPresenter ContentSource="Icon" Width="16" Height="16" Margin="0,0,8,0"/>
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
            </StackPanel>
          </Border>
          <Popup x:Name="PART_Popup" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
            <Border Background="#FBFBFB" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="6" Padding="4"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EAEAEA"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
