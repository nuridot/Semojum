<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:svg="http://sharpvectors.codeplex.com/svgc/">
  <Style x:Key="HelpSearch" TargetType="TextBox">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="#1A1A1A"/>
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="#D1D1D1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#005FB8"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="HelpTab" TargetType="TabItem">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="#5F5F5F"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Grid Height="36" Background="Transparent">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border x:Name="SelectionBar" Width="16" Height="3" CornerRadius="1.5" Background="#005FB8"
                    VerticalAlignment="Bottom" Margin="0,0,0,1" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter Property="Foreground" Value="#003E92"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="HelpTabs" TargetType="TabControl">
    <Setter Property="Width" Value="300"/>
    <Setter Property="Background" Value="#F9F9F9"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource HelpTab}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Border Background="{TemplateBinding Background}" BorderBrush="#EAEAEA" BorderThickness="0,0,1,0">
            <DockPanel>
              <Border DockPanel.Dock="Top" Margin="0,8,0,0" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1">
                <UniformGrid Rows="1" IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
              </Border>
              <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="HelpTopic" TargetType="TreeViewItem">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="#1A1A1A"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TreeViewItem">
          <StackPanel>
            <Border x:Name="TopicSurface" Height="32" Background="Transparent">
              <DockPanel>
                <svg:SvgViewbox x:Name="Arrow" Width="16" Height="16" Margin="12,0,4,0" Visibility="Hidden" Stretch="None"
                                Source="pack://application:,,,/Semojum.Feature.Shell.Wpf;component/Assets/Figma/help-tree-right.svg"/>
                <ContentPresenter x:Name="TopicHeader" ContentSource="Header" VerticalAlignment="Center"/>
              </DockPanel>
            </Border>
            <ItemsPresenter x:Name="TopicChildren" Visibility="Collapsed"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="HasItems" Value="False"><Setter TargetName="TopicHeader" Property="Margin" Value="20,0,0,0"/></Trigger>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="TopicChildren" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Arrow" Property="Source" Value="pack://application:,,,/Semojum.Feature.Shell.Wpf;component/Assets/Figma/help-tree-down.svg"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="TopicSurface" Property="Background" Value="#EFF6FC"/>
              <Setter Property="FontSize" Value="14"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter Property="Foreground" Value="#003E92"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
