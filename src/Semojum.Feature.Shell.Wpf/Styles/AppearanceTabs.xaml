<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate x:Key="AppearanceFont" TargetType="ComboBox">
        <Grid>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4"/>
            <TextBox x:Name="PART_EditableTextBox" Margin="12,1,30,1" Height="Auto" MinHeight="0" Padding="0" Background="Transparent"
                     BorderThickness="0" FontSize="{TemplateBinding FontSize}" VerticalContentAlignment="Center"
                     IsReadOnly="{TemplateBinding IsReadOnly}">
                <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></ControlTemplate></TextBox.Template>
            </TextBox>
            <ToggleButton HorizontalAlignment="Right" Width="30" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
            </ToggleButton>
            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                <Border Background="White" BorderBrush="#D1D1D1" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                    <ScrollViewer MaxHeight="300" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                </Border>
            </Popup>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="AppearanceTabs" TargetType="TabControl">
        <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1" Margin="0,0,0,16">
                <TabPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once"/>
            </Border>
            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
        </DockPanel>
    </ControlTemplate>
    <ControlTemplate x:Key="AppearanceTab" TargetType="TabItem">
        <Grid Height="36" Background="Transparent">
            <StackPanel Margin="16,8,16,0" HorizontalAlignment="Center">
                <TextBlock x:Name="Label" Text="{TemplateBinding Header}" FontSize="14" Height="20"
                           LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="#5F5F5F"/>
                <Border x:Name="Underline" Width="16" Height="3" CornerRadius="1.5" Margin="0,4,0,0" Background="Transparent"/>
            </StackPanel>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Label" Property="Foreground" Value="#003E92"/>
                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="Underline" Property="Background" Value="#005FB8"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
